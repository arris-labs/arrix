{
  "$defs": {
    "arc-segment": {
      "additionalProperties": false,
      "description": "A circular arc through `via` to `to`.",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/vec2"
        },
        "via": {
          "$ref": "#/$defs/vec2"
        }
      },
      "required": [
        "key",
        "to",
        "via"
      ],
      "type": "object"
    },
    "assembly-info": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/component-info"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/joint-info"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "components",
        "joints"
      ],
      "type": "object"
    },
    "axis": {
      "additionalProperties": false,
      "description": "A line in the world: a point on it and a direction (a revolve's axis, an `axis` input). A resolved input's direction is unit.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "origin": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "origin",
        "direction"
      ],
      "type": "object"
    },
    "body": {
      "description": "A body made in this evaluation; valid within it only.",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer",
      "x-handle": "body"
    },
    "body-info": {
      "additionalProperties": false,
      "description": "`material` is none for a body of a part with no material.",
      "properties": {
        "body": {
          "$ref": "#/$defs/body-ref"
        },
        "material": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/material-info"
            }
          ]
        }
      },
      "required": [
        "body"
      ],
      "type": "object"
    },
    "body-ref": {
      "additionalProperties": false,
      "description": "A final body of a part: the body slot a feature made.",
      "properties": {
        "feature": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "slot"
      ],
      "type": "object"
    },
    "choice-option": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "type": "object"
    },
    "choice-spec": {
      "additionalProperties": false,
      "description": "One of a few words, kept in the record's choices. `default` is the option a record that gives none holds; none means the choice left unset is meaningful of itself (ADR-0018).",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/choice-option"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "options"
      ],
      "type": "object"
    },
    "choice-value": {
      "additionalProperties": false,
      "description": "A choice's word, the record's or the spec's default; a choice unset with no default is not given.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "circle-loop": {
      "additionalProperties": false,
      "properties": {
        "center": {
          "$ref": "#/$defs/vec2"
        },
        "key": {
          "$ref": "#/$defs/id"
        },
        "radius": {
          "type": "number"
        }
      },
      "required": [
        "key",
        "center",
        "radius"
      ],
      "type": "object"
    },
    "component-info": {
      "additionalProperties": false,
      "description": "A component where its assembly places it. `path` is the component ids from the assembly down (a nested assembly's own components follow it); `pose` is where the origin and axes of its part or nested assembly land in the assembly's frame. `diagnostics` say why it is not where it was authored (`assembly.unplaced`).",
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "of": {
          "$ref": "#/$defs/component-of"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array"
        },
        "pose": {
          "$ref": "#/$defs/frame"
        }
      },
      "required": [
        "path",
        "name",
        "of",
        "pose",
        "diagnostics"
      ],
      "type": "object"
    },
    "component-of": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "part": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "part"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assembly": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "assembly"
          ],
          "type": "object"
        }
      ]
    },
    "diagnostic": {
      "additionalProperties": false,
      "description": "`code` is `segment(.segment)*`; `candidates` are ranked best first.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/reference"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/reference"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "refs",
        "candidates"
      ],
      "type": "object"
    },
    "exporter-spec": {
      "additionalProperties": false,
      "description": "`id` is `<plugin-id>.<name>`; `extension` is the main file's, without the dot. Options are a feature's fields, so a form is derived as for a feature.",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/choice-spec"
          },
          "type": "array"
        },
        "extension": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/param-spec"
          },
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/subject-kind"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "extension",
        "subject",
        "params",
        "choices"
      ],
      "type": "object"
    },
    "feature-output": {
      "additionalProperties": false,
      "description": "`tool` is a joining or cutting feature's kept tool (ADR-0013).",
      "properties": {
        "slots": {
          "items": {
            "$ref": "#/$defs/slot-output"
          },
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tool"
            }
          ]
        }
      },
      "required": [
        "slots"
      ],
      "type": "object"
    },
    "feature-type-spec": {
      "additionalProperties": false,
      "description": "`id` is `<plugin-id>.<name>`; `version` the type's own schema version.",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/choice-spec"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/input-spec"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/slot-spec"
          },
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/param-spec"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "params",
        "choices",
        "inputs",
        "outputs"
      ],
      "type": "object"
    },
    "file": {
      "additionalProperties": false,
      "description": "`name` is a relative path of `/`-separated parts, none empty, `.` or `..` (ADR-0037 §7). The first file of a result is the main one.",
      "properties": {
        "bytes": {
          "contentEncoding": "base64",
          "description": "The little-endian bytes of a run of `u8`, as base64 (ADR-0022 §5).",
          "type": "string",
          "x-run": "u8"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes"
      ],
      "type": "object"
    },
    "frame": {
      "additionalProperties": false,
      "description": "A right-handed frame, Y = Z x X. A plane is its XY plane, its normal Z.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/vec3"
        },
        "x-axis": {
          "$ref": "#/$defs/vec3"
        },
        "z-axis": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "origin",
        "x-axis",
        "z-axis"
      ],
      "type": "object"
    },
    "id": {
      "description": "An id: 64 bits, as `arrix-core`'s typed ids carry it.",
      "pattern": "^[0-9A-F][0-9A-HJKMNP-TV-Z]{12}$",
      "type": "string"
    },
    "inertia-tensor": {
      "additionalProperties": false,
      "description": "A symmetric inertia tensor, the entries of the matrix: `xy` is the negated product of inertia. kg m^2.",
      "properties": {
        "xx": {
          "type": "number"
        },
        "xy": {
          "type": "number"
        },
        "xz": {
          "type": "number"
        },
        "yy": {
          "type": "number"
        },
        "yz": {
          "type": "number"
        },
        "zz": {
          "type": "number"
        }
      },
      "required": [
        "xx",
        "xy",
        "xz",
        "yy",
        "yz",
        "zz"
      ],
      "type": "object"
    },
    "inertial": {
      "additionalProperties": false,
      "description": "Mass in kg, the centre of mass in the part's frame, and the inertia about it with the part's axes (docs/DATA-MODEL.md §Evaluation).",
      "properties": {
        "centroid": {
          "$ref": "#/$defs/vec3"
        },
        "inertia": {
          "$ref": "#/$defs/inertia-tensor"
        },
        "mass": {
          "type": "number"
        }
      },
      "required": [
        "mass",
        "centroid",
        "inertia"
      ],
      "type": "object"
    },
    "input-kind": {
      "description": "What an input resolves to: a plane (a datum, a planar face, a world plane), a sketch region as a profile keyed by its entities, a body slot's version current at the feature (ADR-0007), an edge by name, a point (a sketch point or a vertex), an axis (a sketch line, a straight edge) or the tool a joining or cutting feature kept (ADR-0012, ADR-0013).",
      "enum": [
        "plane",
        "region",
        "body",
        "edge",
        "point",
        "axis",
        "tool"
      ],
      "type": "string"
    },
    "input-spec": {
      "additionalProperties": false,
      "description": "A `list` input takes several references: it arrives as one `resolved-input` per element, in the record's order, each with the input's name.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/input-kind"
        },
        "list": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "shown-when": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/shown-when"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "kind",
        "list"
      ],
      "type": "object"
    },
    "input-value": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "plane": {
              "$ref": "#/$defs/frame"
            }
          },
          "required": [
            "plane"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "region": {
              "$ref": "#/$defs/profile"
            }
          },
          "required": [
            "region"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/body"
            }
          },
          "required": [
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edge": {
              "$ref": "#/$defs/persistent-ref"
            }
          },
          "required": [
            "edge"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "point": {
              "$ref": "#/$defs/point"
            }
          },
          "required": [
            "point"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/axis"
            }
          },
          "required": [
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tool": {
              "$ref": "#/$defs/tool"
            }
          },
          "required": [
            "tool"
          ],
          "type": "object"
        }
      ]
    },
    "joint-info": {
      "additionalProperties": false,
      "description": "`parent` and `child` are the paths of the components the anchors are on, from the assembly down. `limits` are lower and upper, SI.",
      "properties": {
        "child": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/joint-kind"
        },
        "limits": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/joint-state"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "parent",
        "child",
        "state"
      ],
      "type": "object"
    },
    "joint-kind": {
      "enum": [
        "fixed",
        "revolute",
        "prismatic"
      ],
      "type": "string"
    },
    "joint-placement": {
      "additionalProperties": false,
      "description": "Where a solved joint put its anchors, each in the frame of the component its path ends at. The motion is about their z axes (ADR-0029 §3). `value` is value + offset in SI, radians or metres, zero for a fixed joint.",
      "properties": {
        "child-anchor": {
          "$ref": "#/$defs/frame"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "type": "array"
        },
        "parent-anchor": {
          "$ref": "#/$defs/frame"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "parent-anchor",
        "child-anchor",
        "value",
        "diagnostics"
      ],
      "type": "object"
    },
    "joint-state": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "placed": {
              "$ref": "#/$defs/joint-placement"
            }
          },
          "required": [
            "placed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "failed": {
              "$ref": "#/$defs/diagnostic"
            }
          },
          "required": [
            "failed"
          ],
          "type": "object"
        }
      ]
    },
    "line-segment": {
      "additionalProperties": false,
      "description": "A planar region in (u, v) coordinates of `plane`, every curve keyed: side faces are rooted at a curve's key, so a key must be stable across evaluations for the same logical curve.",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/vec2"
        }
      },
      "required": [
        "key",
        "to"
      ],
      "type": "object"
    },
    "mass-properties": {
      "additionalProperties": false,
      "description": "At unit density: cubic metres, square metres, a point.",
      "properties": {
        "area": {
          "type": "number"
        },
        "centroid": {
          "$ref": "#/$defs/vec3"
        },
        "volume": {
          "type": "number"
        }
      },
      "required": [
        "volume",
        "area",
        "centroid"
      ],
      "type": "object"
    },
    "material-info": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "color"
      ],
      "type": "object"
    },
    "motion": {
      "additionalProperties": false,
      "description": "A proper rigid motion: the body turns by `angle` about the axis through the world origin along `axis`, then moves by `translation`.",
      "properties": {
        "angle": {
          "type": "number"
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "translation": {
          "$ref": "#/$defs/vec3"
        }
      },
      "required": [
        "translation",
        "axis",
        "angle"
      ],
      "type": "object"
    },
    "output-value": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/body"
            }
          },
          "required": [
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "plane": {
              "$ref": "#/$defs/frame"
            }
          },
          "required": [
            "plane"
          ],
          "type": "object"
        }
      ]
    },
    "param-spec": {
      "additionalProperties": false,
      "description": "A numeric field; `default` is an expression (`20`, `1 mm`).",
      "properties": {
        "default": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/quantity-kind"
        },
        "name": {
          "type": "string"
        },
        "shown-when": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/shown-when"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "kind",
        "default"
      ],
      "type": "object"
    },
    "param-value": {
      "additionalProperties": false,
      "description": "A parameter's expression, evaluated by the host to SI.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/quantity"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "part-info": {
      "additionalProperties": false,
      "properties": {
        "bodies": {
          "items": {
            "$ref": "#/$defs/body-info"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "bodies"
      ],
      "type": "object"
    },
    "path-loop": {
      "additionalProperties": false,
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/profile-segment"
          },
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/vec2"
        }
      },
      "required": [
        "start",
        "segments"
      ],
      "type": "object"
    },
    "persistent-ref": {
      "additionalProperties": false,
      "description": "A face, edge or vertex by persistent name, in its canonical text form (docs/DATA-MODEL.md §Persistent naming). Opaque to a plugin.",
      "properties": {
        "encoded": {
          "type": "string"
        }
      },
      "required": [
        "encoded"
      ],
      "type": "object"
    },
    "plugin-ref": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "plugin",
        "record"
      ],
      "type": "object"
    },
    "point": {
      "additionalProperties": false,
      "description": "A point input: where it is in the world, and, for a sketch point, the normal of the sketch's plane.",
      "properties": {
        "at": {
          "$ref": "#/$defs/vec3"
        },
        "normal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/vec3"
            }
          ]
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "holes": {
          "items": {
            "$ref": "#/$defs/profile-loop"
          },
          "type": "array"
        },
        "outer": {
          "$ref": "#/$defs/profile-loop"
        },
        "plane": {
          "$ref": "#/$defs/frame"
        }
      },
