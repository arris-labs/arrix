// The plugin interface (docs/PLUGINS.md §One interface): the authority for
// every tier. `arrix-plugin-api`'s Rust traits and plain types mirror it,
// and `tests/wit_equality.rs` holds the two equal. The package version is
// the crate's version.
//
// SI throughout: metres, radians, kilograms. No Arris type appears here.

package arrix:plugin@0.8.0;

interface types {
  // An id: 64 bits, as `arrix-core`'s typed ids carry it.
  type id = u64;

  record vec2 { x: f64, y: f64 }
  record vec3 { x: f64, y: f64, z: f64 }

  // A right-handed frame, Y = Z x X. A plane is its XY plane, its normal Z.
  record frame { origin: vec3, x-axis: vec3, z-axis: vec3 }

  enum quantity-kind { length, angle, count, ratio, mass, density }
  record quantity { kind: quantity-kind, si: f64 }

  // A face, edge or vertex by persistent name, in its canonical text form
  // (docs/DATA-MODEL.md §Persistent naming). Opaque to a plugin.
  record persistent-ref { encoded: string }

  // A reference to a document record (docs/DATA-MODEL.md §References).
  record slot-ref { feature: id, slot: string }
  record sketch-ref { feature: id, entity: id }
  // A sketch region: the entities bounding it, sorted, and a point inside
  // it in whole nanometres of the sketch's (u, v).
  record region-ref { feature: id, entities: list<id>, sample: tuple<s64, s64> }
  record plugin-ref { plugin: string, %record: id }
  variant reference {
    param(id),
    feature(id),
    slot(slot-ref),
    topo(persistent-ref),
    sketch(sketch-ref),
    region(region-ref),
    plugin(plugin-ref),
  }

  enum severity { info, warning, error }
  // `code` is `segment(.segment)*`; `candidates` are ranked best first.
  record diagnostic {
    severity: severity,
    code: string,
    message: string,
    refs: list<reference>,
    candidates: list<reference>,
  }

  // A planar region in (u, v) coordinates of `plane`, every curve keyed:
  // side faces are rooted at a curve's key, so a key must be stable across
  // evaluations for the same logical curve.
  record line-segment { key: id, to: vec2 }
  // A circular arc through `via` to `to`.
  record arc-segment { key: id, to: vec2, via: vec2 }
  variant profile-segment { line(line-segment), arc(arc-segment) }
  record circle-loop { key: id, center: vec2, radius: f64 }
  record path-loop { start: vec2, segments: list<profile-segment> }
  variant profile-loop { circle(circle-loop), path(path-loop) }
  record profile { plane: frame, outer: profile-loop, holes: list<profile-loop> }

  // At unit density: cubic metres, square metres, a point.
  record mass-properties { volume: f64, area: f64, centroid: vec3 }

  // A line in the world: a point on it and a direction (a revolve's axis,
  // an `axis` input). A resolved input's direction is unit.
  record axis { origin: vec3, direction: vec3 }
  // A point input: where it is in the world, and, for a sketch point, the
  // normal of the sketch's plane.
  record point { at: vec3, normal: option<vec3> }
  // A colour: red, green and blue in 0 to 1.
  record rgb { red: f64, green: f64, blue: f64 }
  // A final body of a part: the body slot a feature made.
  record body-ref { feature: id, slot: string }
  enum joint-kind { fixed, revolute, prismatic }
  // What a component places.
  variant component-of { part(id), assembly(id) }

  // A parameter's expression, evaluated by the host to SI.
  record param-value { name: string, value: quantity }
  // A choice's word, the record's or the spec's default; a choice unset
  // with no default is not given.
  record choice-value { name: string, value: string }

  // A proper rigid motion: the body turns by `angle` about the axis through
  // the world origin along `axis`, then moves by `translation`.
  record motion { translation: vec3, axis: vec3, angle: f64 }
}

// The kernel, a host service: operations with ArriX's signatures, each
// recorded like a built-in's call (docs/ARCHITECTURE.md §The kernel choke
// point). Everything built is named from provenance, as the calling
// feature's.
interface kernel {
  use types.{axis, diagnostic, frame, mass-properties, motion, persistent-ref, profile, vec3};

  // A body made in this evaluation; valid within it only.
  resource body;

  // `p` swept `distance` along its plane's normal, against it when negative.
  extrude: func(p: profile, distance: f64) -> result<body, diagnostic>;
  // `p` turned `angle` radians (at most a full turn) about `a`. Counted
  // with the extrudes in the feature's sweep numbering (ADR-0011).
  revolve: func(p: profile, a: axis, angle: f64) -> result<body, diagnostic>;
  // Every face, edge and vertex of `b`, by name.
  names: func(b: borrow<body>) -> result<list<persistent-ref>, diagnostic>;
  // The outward frame of a planar face of `b`.
  face-frame: func(b: borrow<body>, face: persistent-ref) -> result<frame, diagnostic>;
  // Volume, area and centroid of `b`.
  measure: func(b: borrow<body>) -> result<mass-properties, diagnostic>;
  // `target` joined with `tool`, and `target` less `tool`: new bodies,
  // the operands left as they were.
  fuse: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  cut: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  // What `target` and `tool` have in common.
  common: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  // `b` with `edges` rounded at `radius` metres, or cut flat at `distance`.
  // A feature's booleans and blends are numbered in call order (ADR-0014).
  fillet: func(b: borrow<body>, edges: list<persistent-ref>, radius: f64) -> result<body, diagnostic>;
  chamfer: func(b: borrow<body>, edges: list<persistent-ref>, distance: f64) -> result<body, diagnostic>;
  // `b` moved by `m`, every entity named as copy `index` of the calling
  // feature (index from 1: raising a pattern's count renames no copy that
  // stays, ADR-0010), and `b` reflected in the plane through `origin` with
  // `normal`, named as copy 1. The operand is left as it was.
  copy: func(index: u32, b: borrow<body>, m: motion) -> result<body, diagnostic>;
  mirror: func(b: borrow<body>, origin: vec3, normal: vec3) -> result<body, diagnostic>;
}

// Feature types (docs/PLUGINS.md §Contribution points, 1).
interface feature {
  use types.{
    axis, choice-value, diagnostic, frame, param-value, persistent-ref, point, profile, quantity,
    quantity-kind,
  };
  use kernel.{body};

  // A field shown only while the type's choice `choice` holds one of
  // `values` (ADR-0018). A hidden field is neither shown nor required; its
  // value, if the record has one, is kept.
  record shown-when { choice: string, values: list<string> }
  // A numeric field; `default` is an expression (`20`, `1 mm`).
  record param-spec {
    name: string,
    title: string,
    kind: quantity-kind,
    default: string,
    shown-when: option<shown-when>,
  }
  record choice-option { name: string, title: string }
  // One of a few words, kept in the record's choices. `default` is the
  // option a record that gives none holds; none means the choice left unset
  // is meaningful of itself (ADR-0018).
  record choice-spec {
    name: string,
    title: string,
    options: list<choice-option>,
    default: option<string>,
  }
  // What an input resolves to: a plane (a datum, a planar face, a world
  // plane), a sketch region as a profile keyed by its entities, a body
  // slot's version current at the feature (ADR-0007), an edge by name, a
  // point (a sketch point or a vertex), an axis (a sketch line, a straight
  // edge) or the tool a joining or cutting feature kept (ADR-0012,
  // ADR-0013).
  enum input-kind { plane, region, body, edge, point, axis, tool }
  // A `list` input takes several references: it arrives as one
  // `resolved-input` per element, in the record's order, each with the
  // input's name.
  record input-spec {
    name: string,
    title: string,
    kind: input-kind,
    %list: bool,
    shown-when: option<shown-when>,
  }
  enum slot-kind { body, plane }
  // An output slot; `name` is one lower-kebab word. A body slot that
  // `modifies` a body input is that input's slot's next version, not a
  // slot of its own; a body input no slot modifies is a tool, and its
  // slot ends (ADR-0007).
  record slot-spec { name: string, kind: slot-kind, modifies: option<string> }
  // `id` is `<plugin-id>.<name>`; `version` the type's own schema version.
  record feature-type-spec {
    id: string,
    version: u32,
    title: string,
    params: list<param-spec>,
    choices: list<choice-spec>,
    inputs: list<input-spec>,
    outputs: list<slot-spec>,
  }

  // A body input is a handle of the plugin's own to the slot's version,
  // dropped when it is done: an owned handle rather than a borrow, which
  // wit-bindgen's Rust guests cannot take inside a list (ADR-0008).
  // The tool a feature that joins or cuts applied, kept so a pattern or a
  // mirror can copy it, and the operation it was applied with. As an input
  // it is the source feature's, an owned handle; as an output it is the
  // body the feature built, given up.
  enum tool-op { fuse, cut }
  record tool { body: body, op: tool-op }
  variant input-value {
    plane(frame),
    region(profile),
    body(body),
    edge(persistent-ref),
    point(point),
    axis(axis),
    tool(tool),
  }
  record resolved-input { name: string, value: input-value }
  variant output-value { body(body), plane(frame) }
  record slot-output { name: string, value: output-value }
  // `tool` is a joining or cutting feature's kept tool (ADR-0013).
  record feature-output { slots: list<slot-output>, tool: option<tool> }

  describe: func() -> list<feature-type-spec>;
  // Deterministic: a pure function of its arguments, the kernel's results
  // and the plugin's version.
  evaluate: func(
    type-id: string,
    params: list<param-value>,
    choices: list<choice-value>,
    inputs: list<resolved-input>,
  ) -> result<feature-output, diagnostic>;
}

// The evaluated document, read (docs/PLUGINS.md §One interface, ADR-0037):
// parts, their final bodies' meshes, assemblies with solved poses and
// joints, mass and inertia. Read-only, by function so a plugin fetches only
// what it writes. Granted by `document-read`, and callable only while an
// `exchange` or `commands` call runs, against the generation that call was
// made on.
interface document {
  use types.{
    body-ref, choice-value, component-of, diagnostic, frame, id, joint-kind, param-value, rgb, vec3,
  };

  record material-info { name: string, color: rgb }
  // `material` is none for a body of a part with no material.
  record body-info { body: body-ref, material: option<material-info> }
  // A history feature, evaluated (ADR-0038 §4): its type, name, the choices
  // it holds (the record's or the spec's defaults) and its params in SI.
  record feature-info {
    id: id,
    type-id: string,
    name: string,
    choices: list<choice-value>,
    params: list<param-value>,
  }
  // `features` are the part's history, in order.
  record part-info { id: id, name: string, bodies: list<body-info>, features: list<feature-info> }

  // A refined mesh in the part's frame, the refined chord (1e-4 of the body's box diagonal, as STL export, ADR-0037 §4): three
  // `f32` per vertex in `positions` and `normals`, three `u32` per triangle
  // in `indices`, counter-clockwise seen from outside.
  record triangles { positions: list<f32>, normals: list<f32>, indices: list<u32> }

  // A symmetric inertia tensor, the entries of the matrix: `xy` is the
  // negated product of inertia. kg m^2.
  record inertia-tensor { xx: f64, xy: f64, xz: f64, yy: f64, yz: f64, zz: f64 }
  // Mass in kg, the centre of mass in the part's frame, and the inertia
  // about it with the part's axes (docs/DATA-MODEL.md §Evaluation).
  record inertial { mass: f64, centroid: vec3, inertia: inertia-tensor }

  // A component where its assembly places it. `path` is the component ids
  // from the assembly down (a nested assembly's own components follow it);
  // `pose` is where the origin and axes of its part or nested assembly
  // land in the assembly's frame. `diagnostics` say why it is not where it
  // was authored (`assembly.unplaced`).
  record component-info {
    path: list<id>,
    name: string,
    of: component-of,
    pose: frame,
    diagnostics: list<diagnostic>,
  }
  // Where a solved joint put its anchors, each in the frame of the
  // component its path ends at. The motion is about their z axes
  // (ADR-0029 §3). `value` is value + offset in SI, radians or metres,
  // zero for a fixed joint.
  record joint-placement {
    parent-anchor: frame,
    child-anchor: frame,
    value: f64,
    diagnostics: list<diagnostic>,
  }
  variant joint-state { placed(joint-placement), failed(diagnostic) }
  // `parent` and `child` are the paths of the components the anchors are
  // on, from the assembly down. `limits` are lower and upper, SI.
  record joint-info {
    id: id,
    name: string,
    kind: joint-kind,
    parent: list<id>,
    child: list<id>,
    limits: option<tuple<f64, f64>>,
    state: joint-state,
  }
  record assembly-info {
    id: id,
    name: string,
    components: list<component-info>,
    joints: list<joint-info>,
  }

  parts: func() -> list<part-info>;
  // The refined mesh of one final body of `part`.
  mesh: func(part: id, body: body-ref) -> result<triangles, diagnostic>;
  // The part's mass properties, or the `mass.*` diagnostic.
  mass: func(part: id) -> result<inertial, diagnostic>;
  assemblies: func() -> list<assembly-info>;
}

// Exporters (docs/PLUGINS.md §Contribution points, 4): a snapshot in
// through `document`, files out. The host writes them.
interface exchange {
  use types.{choice-value, diagnostic, id, param-value};
  use feature.{choice-spec, param-spec};

  enum subject-kind { part, assembly }
  variant subject { part(id), assembly(id) }
  // `id` is `<plugin-id>.<name>`; `extension` is the main file's, without
  // the dot. Options are a feature's fields, so a form is derived as for a
  // feature.
  record exporter-spec {
    id: string,
    title: string,
    extension: string,
    subject: subject-kind,
    params: list<param-spec>,
    choices: list<choice-spec>,
  }
  // `name` is a relative path of `/`-separated parts, none empty, `.` or
  // `..` (ADR-0037 §7). The first file of a result is the main one.
  record file { name: string, bytes: list<u8> }

  exporters: func() -> list<exporter-spec>;
  // Deterministic: a pure function of the snapshot and the options.
  run: func(
    exporter: string,
    subject: subject,
    params: list<param-value>,
    choices: list<choice-value>,
  ) -> result<list<file>, diagnostic>;
}

// Commands (docs/PLUGINS.md §Contribution points, 3; ADR-0038): a gesture the
// plugin expands into one group of core commands, which the session submits
// and inverts like any other. The records are plain mirrors of the core
// commands a plugin may issue; the host checks and translates them.
interface commands {
  use types.{
    body-ref, choice-value, component-of, diagnostic, id, joint-kind, param-value, persistent-ref,
    quantity, reference, rgb, vec3,
  };
  use feature.{choice-spec, input-spec, param-spec};

  // `id` is `<plugin-id>.<name>`; `group` the ribbon group it sits in on the
  // plugin's tab. `params`, `choices` and `inputs` are a feature type's
  // specs and derive a form as for a feature; an input's kind is `edge`
  // alone at 0.8. `max-new` is the most ids one expansion uses (64 if none).
  record command-spec {
    id: string,
    title: string,
    group: string,
    params: list<param-spec>,
    choices: list<choice-spec>,
    inputs: list<input-spec>,
    max-new: option<u32>,
  }

  // What the client's tab looks at, and the frame inputs arrive in.
  variant context { part(id), assembly(id) }

  // An edge input, resolved against the base generation: `path` is the
  // component ids from the assembly down (empty in a part), `name` the
  // edge, `curve` its geometry in the context's frame, and `face-normals`
  // the outward normals of the planar faces it bounds, in the order of
  // their names.
  record circle-edge { centre: vec3, axis: vec3, radius: f64 }
  record line-edge { start: vec3, end: vec3 }
  variant edge-curve { circle(circle-edge), line(line-edge), other }
  record resolved-edge {
    path: list<id>,
    name: persistent-ref,
    curve: edge-curve,
    face-normals: list<vec3>,
  }
  variant command-input-value { edge(resolved-edge) }
  // A `list` input arrives as one `command-input` per element.
  record command-input { name: string, value: command-input-value }

  // A value in a record: SI, or an expression's text the host parses.
  variant expression { si(quantity), text(string) }
  record named-expression { name: string, expression: expression }
  // An input of a drafted feature: its references; `many` for a list input.
  record named-input { name: string, refs: list<reference>, many: bool }

  // A feature as a plugin drafts it; the host fills the type's version.
  record feature-draft {
    id: id,
    type-id: string,
    name: string,
    params: list<named-expression>,
    choices: list<choice-value>,
    inputs: list<named-input>,
  }
  record part-draft {
    id: id,
    name: string,
    features: list<feature-draft>,
    material: option<id>,
  }
  // Appended to the part's history when `at` is none.
  record add-feature { part: id, at: option<u32>, feature: feature-draft }

  // A position (three lengths) and URDF's fixed-axis roll, pitch and yaw
  // (three angles).
  record pose {
    position: tuple<expression, expression, expression>,
    rpy: tuple<expression, expression, expression>,
  }
  record component-draft {
    id: id,
    name: string,
    of: component-of,
    pose: option<pose>,
  }
  record component-change { assembly: id, component: component-draft }
  // Where a joint attaches: `axis` and `origin` name a face or an edge of
  // the part the path ends at (ADR-0029).
  record anchor { path: list<id>, axis: persistent-ref, origin: option<persistent-ref> }
  record joint-draft {
    id: id,
    name: string,
    kind: joint-kind,
    parent: anchor,
    child: anchor,
    value: expression,
    offset: expression,
    limits: option<tuple<expression, expression>>,
    flip: bool,
  }
  record joint-change { assembly: id, joint: joint-draft }
  record material-draft { id: id, name: string, density: option<expression>, color: rgb }
  // Sets what a part, or one of its final bodies, is made of; none clears.
  record assign-material { part: id, body: option<body-ref>, material: option<id> }

  variant plugin-command {
    add-part(part-draft),
    add-feature(add-feature),
    add-component(component-change),
    edit-component(component-change),
    add-joint(joint-change),
    edit-joint(joint-change),
    add-material(material-draft),
    assign-material(assign-material),
  }
  record command-group { label: string, commands: list<plugin-command> }

  commands: func() -> list<command-spec>;
  // Deterministic: a pure function of its arguments and the snapshot.
  // `ids` are fresh, taken in order; `params` are evaluated.
  expand: func(
    command: string,
    context: context,
    params: list<param-value>,
    choices: list<choice-value>,
    inputs: list<command-input>,
    ids: list<id>,
  ) -> result<command-group, diagnostic>;
}

world plugin {
  import kernel;
  import document;
  export feature;
  export exchange;
  export commands;
}
