// The plugin interface (docs/PLUGINS.md §One interface): the authority for
// every tier. `arrix-plugin-api`'s Rust traits and plain types mirror it,
// and `tests/wit_equality.rs` holds the two equal. The package version is
// the crate's version.
//
// SI throughout: metres, radians, kilograms. No Arris type appears here.

package arrix:plugin@0.5.0;

interface types {
  // An id: 64 bits, as `arrix-core`'s typed ids carry it.
  type id = u64;

  record vec2 { x: f64, y: f64 }
  record vec3 { x: f64, y: f64, z: f64 }

  // A right-handed frame, Y = Z x X. A plane is its XY plane, its normal Z.
  record frame { origin: vec3, x-axis: vec3, z-axis: vec3 }

  enum quantity-kind { length, angle, count, ratio, mass }
  record quantity { kind: quantity-kind, si: f64 }

  // A face, edge or vertex by persistent name, in its canonical text form
  // (docs/DATA-MODEL.md §Persistent naming). Opaque to a plugin.
  record persistent-ref { encoded: string }

  // A reference to a document record (docs/DATA-MODEL.md §References).
  record slot-ref { feature: id, slot: string }
  record sketch-ref { feature: id, entity: id }
  // A sketch region: the entities bounding it, sorted, and a point inside
  // it in whole nanometres of the sketch's (u, v).
  record region-ref { feature: id, entities: list<id>, sample: tuple<s64, s64> }
  record plugin-ref { plugin: string, %record: id }
  variant reference {
    param(id),
    feature(id),
    slot(slot-ref),
    topo(persistent-ref),
    sketch(sketch-ref),
    region(region-ref),
    plugin(plugin-ref),
  }

  enum severity { info, warning, error }
  // `code` is `segment(.segment)*`; `candidates` are ranked best first.
  record diagnostic {
    severity: severity,
    code: string,
    message: string,
    refs: list<reference>,
    candidates: list<reference>,
  }

  // A planar region in (u, v) coordinates of `plane`, every curve keyed:
  // side faces are rooted at a curve's key, so a key must be stable across
  // evaluations for the same logical curve.
  record line-segment { key: id, to: vec2 }
  // A circular arc through `via` to `to`.
  record arc-segment { key: id, to: vec2, via: vec2 }
  variant profile-segment { line(line-segment), arc(arc-segment) }
  record circle-loop { key: id, center: vec2, radius: f64 }
  record path-loop { start: vec2, segments: list<profile-segment> }
  variant profile-loop { circle(circle-loop), path(path-loop) }
  record profile { plane: frame, outer: profile-loop, holes: list<profile-loop> }

  // At unit density: cubic metres, square metres, a point.
  record mass-properties { volume: f64, area: f64, centroid: vec3 }

  // A line in the world: a point on it and a direction (a revolve's axis,
  // an `axis` input). A resolved input's direction is unit.
  record axis { origin: vec3, direction: vec3 }
  // A point input: where it is in the world, and, for a sketch point, the
  // normal of the sketch's plane.
  record point { at: vec3, normal: option<vec3> }
  // A proper rigid motion: the body turns by `angle` about the axis through
  // the world origin along `axis`, then moves by `translation`.
  record motion { translation: vec3, axis: vec3, angle: f64 }
}

// The kernel, a host service: operations with ArriX's signatures, each
// recorded like a built-in's call (docs/ARCHITECTURE.md §The kernel choke
// point). Everything built is named from provenance, as the calling
// feature's.
interface kernel {
  use types.{axis, diagnostic, frame, mass-properties, motion, persistent-ref, profile, vec3};

  // A body made in this evaluation; valid within it only.
  resource body;

  // `p` swept `distance` along its plane's normal, against it when negative.
  extrude: func(p: profile, distance: f64) -> result<body, diagnostic>;
  // `p` turned `angle` radians (at most a full turn) about `a`. Counted
  // with the extrudes in the feature's sweep numbering (ADR-0011).
  revolve: func(p: profile, a: axis, angle: f64) -> result<body, diagnostic>;
  // Every face, edge and vertex of `b`, by name.
  names: func(b: borrow<body>) -> result<list<persistent-ref>, diagnostic>;
  // The outward frame of a planar face of `b`.
  face-frame: func(b: borrow<body>, face: persistent-ref) -> result<frame, diagnostic>;
  // Volume, area and centroid of `b`.
  measure: func(b: borrow<body>) -> result<mass-properties, diagnostic>;
  // `target` joined with `tool`, and `target` less `tool`: new bodies,
  // the operands left as they were.
  fuse: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  cut: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  // What `target` and `tool` have in common.
  common: func(target: borrow<body>, tool: borrow<body>) -> result<body, diagnostic>;
  // `b` with `edges` rounded at `radius` metres, or cut flat at `distance`.
  // A feature's booleans and blends are numbered in call order (ADR-0014).
  fillet: func(b: borrow<body>, edges: list<persistent-ref>, radius: f64) -> result<body, diagnostic>;
  chamfer: func(b: borrow<body>, edges: list<persistent-ref>, distance: f64) -> result<body, diagnostic>;
  // `b` moved by `m`, every entity named as copy `index` of the calling
  // feature (index from 1: raising a pattern's count renames no copy that
  // stays, ADR-0010), and `b` reflected in the plane through `origin` with
  // `normal`, named as copy 1. The operand is left as it was.
  copy: func(index: u32, b: borrow<body>, m: motion) -> result<body, diagnostic>;
  mirror: func(b: borrow<body>, origin: vec3, normal: vec3) -> result<body, diagnostic>;
}

// Feature types (docs/PLUGINS.md §Contribution points, 1).
interface feature {
  use types.{axis, diagnostic, frame, persistent-ref, point, profile, quantity, quantity-kind};
  use kernel.{body};

  // A field shown only while the type's choice `choice` holds one of
  // `values` (ADR-0018). A hidden field is neither shown nor required; its
  // value, if the record has one, is kept.
  record shown-when { choice: string, values: list<string> }
  // A numeric field; `default` is an expression (`20`, `1 mm`).
  record param-spec {
    name: string,
    title: string,
    kind: quantity-kind,
    default: string,
    shown-when: option<shown-when>,
  }
  record choice-option { name: string, title: string }
  // One of a few words, kept in the record's choices. `default` is the
  // option a record that gives none holds; none means the choice left unset
  // is meaningful of itself (ADR-0018).
  record choice-spec {
    name: string,
    title: string,
    options: list<choice-option>,
    default: option<string>,
  }
  // What an input resolves to: a plane (a datum, a planar face, a world
  // plane), a sketch region as a profile keyed by its entities, a body
  // slot's version current at the feature (ADR-0007), an edge by name, a
  // point (a sketch point or a vertex), an axis (a sketch line, a straight
  // edge) or the tool a joining or cutting feature kept (ADR-0012,
  // ADR-0013).
  enum input-kind { plane, region, body, edge, point, axis, tool }
  // A `list` input takes several references: it arrives as one
  // `resolved-input` per element, in the record's order, each with the
  // input's name.
  record input-spec {
    name: string,
    title: string,
    kind: input-kind,
    %list: bool,
    shown-when: option<shown-when>,
  }
  enum slot-kind { body, plane }
  // An output slot; `name` is one lower-kebab word. A body slot that
  // `modifies` a body input is that input's slot's next version, not a
  // slot of its own; a body input no slot modifies is a tool, and its
  // slot ends (ADR-0007).
  record slot-spec { name: string, kind: slot-kind, modifies: option<string> }
  // `id` is `<plugin-id>.<name>`; `version` the type's own schema version.
  record feature-type-spec {
    id: string,
    version: u32,
    title: string,
    params: list<param-spec>,
    choices: list<choice-spec>,
    inputs: list<input-spec>,
    outputs: list<slot-spec>,
  }

  // A parameter's expression, evaluated by the host to SI.
  record param-value { name: string, value: quantity }
  // A choice's word, the record's or the spec's default; a choice unset
  // with no default is not given.
  record choice-value { name: string, value: string }
  // A body input is a handle of the plugin's own to the slot's version,
  // dropped when it is done: an owned handle rather than a borrow, which
  // wit-bindgen's Rust guests cannot take inside a list (ADR-0008).
  // The tool a feature that joins or cuts applied, kept so a pattern or a
  // mirror can copy it, and the operation it was applied with. As an input
  // it is the source feature's, an owned handle; as an output it is the
  // body the feature built, given up.
  enum tool-op { fuse, cut }
  record tool { body: body, op: tool-op }
  variant input-value {
    plane(frame),
    region(profile),
    body(body),
    edge(persistent-ref),
    point(point),
    axis(axis),
    tool(tool),
  }
  record resolved-input { name: string, value: input-value }
  variant output-value { body(body), plane(frame) }
  record slot-output { name: string, value: output-value }
  // `tool` is a joining or cutting feature's kept tool (ADR-0013).
  record feature-output { slots: list<slot-output>, tool: option<tool> }

  describe: func() -> list<feature-type-spec>;
  // Deterministic: a pure function of its arguments, the kernel's results
  // and the plugin's version.
  evaluate: func(
    type-id: string,
    params: list<param-value>,
    choices: list<choice-value>,
    inputs: list<resolved-input>,
  ) -> result<feature-output, diagnostic>;
}

world plugin {
  import kernel;
  export feature;
}
