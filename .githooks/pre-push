#!/bin/sh
# The slow half of the gate (docs/ARCHITECTURE.md §Gates), mirrored by CI.
# `/work` runs these itself before a step is ticked (.agents/rules/git.md).
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo test"
cargo test --workspace

echo "pre-push: cargo test --all-features"
cargo test --workspace --all-features

echo "pre-push: wasm32 build"
cargo build --target wasm32-unknown-unknown --workspace --exclude arrix-cli

echo "pre-push: gate-selftest"
scripts/gate-selftest
