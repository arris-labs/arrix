#!/bin/sh
# The slow half of the gate (docs/ARCHITECTURE.md §Gates), mirrored by CI.
# `/work` runs these itself before a step is ticked (.agents/rules/git.md).
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo test"
cargo test --workspace

echo "pre-push: cargo test --all-features"
cargo test --workspace --all-features

echo "pre-push: wasm32 build"
cargo build --target wasm32-unknown-unknown --workspace --exclude arrix-cli

# Each Rust plugin is a workspace of its own (plans/c3-m3 Findings 7): its
# tests, and its Tier 1 module where its own guest test builds it.
echo "pre-push: plugins/gears"
cargo test --manifest-path plugins/gears/Cargo.toml
cargo build --release --target wasm32-unknown-unknown --features guest --manifest-path plugins/gears/Cargo.toml --target-dir plugins/gears/target/guest
echo "pre-push: plugins/robotics"
cargo test --manifest-path plugins/robotics/Cargo.toml
cargo build --release --target wasm32-unknown-unknown --features guest --manifest-path plugins/robotics/Cargo.toml --target-dir plugins/robotics/target/guest

echo "pre-push: gate-selftest"
scripts/gate-selftest
