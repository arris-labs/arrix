#!/usr/bin/env python3
"""Proves each lint of the gate fails on the violation it exists for
(docs/ARCHITECTURE.md §Gates, docs/ROADMAP.md §M0 accept).

The working tree (tracked and untracked files, `.gitignore` respected) is
copied to a temporary directory once per case; the case appends a snippet to
one file, and the copy's own lint must exit 1 (a violation) or 0 (a
counter-case: the exemption the lint promises). The clean copy must pass
every lint first, so a failing case is never the tree's own fault.

Every case's file must end in the section the snippet belongs to (a
manifest's `[dependencies]`, a crate root's items).

It checks that CI's test job sets every `ARRIX_REQUIRE_*` flag a test
reads (the visual tests' lavapipe, the browser tests' Chromium), so a test
that skips loudly on a developer's machine never skips quietly in CI.

It also checks that CI runs the gate's commands: the steps of
`.github/workflows/ci.yml` named `gate: …` must run exactly the commands of
`.githooks/pre-commit` and `scripts/gate` (ADR-0041), each as often, so the
two cannot drift; that the gate runs each Rust plugin under `plugins/`, a workspace of
its own (plans/c3-m3 Findings 7), by its clippy, nextest, doctests and guest build; and
that the check fails on a planted drift of either kind.

Usage:
    scripts/gate-selftest
"""
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

LINTS = ("size-lint", "wasm-lint", "layer-lint")

LONG_FN = "\npub fn oversize() {\n" + "    let _ = 0;\n" * 200 + "}\n"

# (name, lint, file, appended snippet, expected exit code)
CASES = [
    ("oversize function", "size-lint", "crates/arrix-core/src/lib.rs", LONG_FN, 1),
    (
        "oversize function in mod tests",
        "size-lint",
        "crates/arrix-core/src/lib.rs",
        "\n#[cfg(test)]\nmod tests {" + LONG_FN + "}\n",
        0,
    ),
    (
        "Instant::now in a core crate",
        "wasm-lint",
        "crates/arrix-core/src/lib.rs",
        "\npub fn now() -> std::time::Instant {\n    std::time::Instant::now()\n}\n",
        1,
    ),
    (
        "Instant under the audit marker",
        "wasm-lint",
        "crates/arrix-core/src/lib.rs",
        '\n#[allow(clippy::disallowed_types, reason = "native-only")]\n'
        "pub fn now() -> std::time::Instant {\n    std::time::Instant::now()\n}\n",
        0,
    ),
    (
        "std::fs in arrix-doc",
        "wasm-lint",
        "crates/arrix-doc/src/lib.rs",
        '\npub fn read() -> Vec<u8> {\n    std::fs::read("x").unwrap_or_default()\n}\n',
        1,
    ),
    (
        "std::fs in the app's config_files",
        "wasm-lint",
        "crates/arrix-app/src/config_files.rs",
        '\npub fn read() -> Vec<u8> {\n    std::fs::read("x").unwrap_or_default()\n}\n',
        0,
    ),
    (
        "std::fs elsewhere in the app",
        "wasm-lint",
        "crates/arrix-app/src/lib.rs",
        '\npub fn read() -> Vec<u8> {\n    std::fs::read("x").unwrap_or_default()\n}\n',
        1,
    ),
    (
        "std::fs in the native-only browser harness",
        "wasm-lint",
        "crates/arrix-web-test/src/lib.rs",
        '\npub fn read() -> Vec<u8> {\n    std::fs::read("x").unwrap_or_default()\n}\n',
        0,
    ),
    (
        "thread::spawn outside the executor",
        "wasm-lint",
        "crates/arrix-kernel/src/lib.rs",
        "\npub fn go() {\n    std::thread::spawn(|| {});\n}\n",
        1,
    ),
    ("egui dependency in arrix-doc", "layer-lint", "crates/arrix-doc/Cargo.toml", "egui.workspace = true\n", 1),
    ("wasmtime dependency in arrix-doc", "layer-lint", "crates/arrix-doc/Cargo.toml", "wasmtime.workspace = true\n", 1),
    ("egui path in arrix-doc", "layer-lint", "crates/arrix-doc/src/lib.rs", "\npub use egui::Context;\n", 1),
    ("egui named in a comment in arrix-doc", "layer-lint", "crates/arrix-doc/src/lib.rs", "\n// egui::Context\n", 0),
    ("arris path outside arrix-kernel", "layer-lint", "crates/arrix-doc/src/lib.rs", "\npub use arris::Model;\n", 1),
    (
        "a second arrix-* dependency in a plugin",
        "layer-lint",
        "plugins/gears/Cargo.toml",
        'arrix-core = { path = "../../crates/arrix-core" }\n',
        1,
    ),
    (
        "arrix-ui reaching arrix-doc through another crate",
        "layer-lint",
        "crates/arrix-ui/Cargo.toml",
        "arrix-plugin-host.workspace = true\n",
        1,
    ),
]


GATE = (".githooks/pre-commit", "scripts/gate")
CI = ".github/workflows/ci.yml"

# (name, file, text replaced, replacement): each must make the gate drift.
# A replaced text of None writes the file whole.
DRIFT_CASES = [
    (
        "a gate command CI does not run",
        "scripts/gate",
        "scripts/gate-selftest\n",
        "scripts/gate-selftest\ncargo doc --workspace\n",
    ),
    (
        "a CI gate step the gate does not run",
        CI,
        "run: cargo nextest run --workspace --all-features",
        "run: cargo nextest run --workspace --all-features --release",
    ),
    (
        "a web build the gate does not run",
        "scripts/gate",
        "scripts/web-build\n",
        "",
    ),
    (
        "CI running one test command twice, the other never",
        CI,
        "        run: cargo nextest run --workspace --all-features\n",
        "        run: cargo nextest run --workspace\n",
    ),
    (
        "CI letting the browser tests skip",
        CI,
        '      ARRIX_REQUIRE_BROWSER: "1"\n',
        "",
    ),
    (
        "a plugin workspace the gate does not run",
        "plugins/extra/Cargo.toml",
        None,
        '[package]\nname = "arrix-extra"\nversion = "0.0.0"\n\n[workspace]\n',
    ),
]

GATE_STEP_RE = re.compile(r"^\s*(?:-\s+)?name:\s*[\"']?gate: ")
RUN_RE = re.compile(r"^\s*run:\s*(.*?)\s*$")
STEP_RE = re.compile(r"^\s*-\s")


def gate_commands(tree):
    """The commands the gate runs: every line but the shebang, comments,
    `echo`, `set`, `cd`, the `command -v` check for a tool, the re-exec under `scripts/heavy`
    and the gate's lock on the target directory (`mkdir`, `exec 9>`)."""
    out = []
    for script in GATE:
        for line in (tree / script).read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and not re.match(r'(echo|set|cd|command|mkdir)\b|exec 9>|\[ -n "\$ARRIX_HEAVY" \]', line):
                out.append(line)
    return out


def ci_gate_commands(tree):
    """The one-line `run:` of every step named `gate: …` in the workflow.
    A multi-line run is kept as its `|` or `>`, so it cannot match."""
    out, in_gate_step = [], False
    for line in (tree / CI).read_text().splitlines():
        if STEP_RE.match(line):
            in_gate_step = False
        if GATE_STEP_RE.match(line):
            in_gate_step = True
        run = RUN_RE.match(line)
        if run and in_gate_step:
            out.append(run.group(1))
            in_gate_step = False
    return out


def ci_drift(tree):
    """How CI and the gate disagree, as lines; empty when they agree."""
    gate, ci = Counter(gate_commands(tree)), Counter(ci_gate_commands(tree))
    return [f"the gate runs {c!r} {n}x, CI {ci[c]}x" for c, n in (gate - ci).items()] + [
        f"CI runs {c!r} {n}x, the gate {gate[c]}x" for c, n in (ci - gate).items()
    ]


def plugin_commands(manifest):
    """The commands the gate runs for the Rust plugin at `manifest`."""
    at = manifest.parent.as_posix()
    return [
        f"cargo clippy --manifest-path {manifest.as_posix()} --all-targets --all-features -- -D warnings",
        f"cargo nextest run --manifest-path {manifest.as_posix()}",
        f"cargo test --doc --manifest-path {manifest.as_posix()}",
        "cargo build --release --target wasm32-unknown-unknown --features guest "
        f"--manifest-path {manifest.as_posix()} --target-dir {at}/target/guest",
    ]


def plugin_drift(tree):
    """The commands a Rust plugin's workspace needs that the gate lacks."""
    gate = set(gate_commands(tree))
    out = []
    for manifest in sorted(tree.glob("plugins/*/Cargo.toml")):
        for command in plugin_commands(manifest.relative_to(tree)):
            if command not in gate:
                out.append(f"the gate does not run {command!r}")
    return out


REQUIRE_RE = re.compile(r"\bARRIX_REQUIRE_[A-Z0-9_]+\b")


def require_drift(tree):
    """The `ARRIX_REQUIRE_*` flags the crates' code reads that CI does not
    set to "1"."""
    read = set()
    for path in tree.glob("crates/**/*.rs"):
        read |= set(REQUIRE_RE.findall(path.read_text(encoding="utf-8", errors="replace")))
    ci = (tree / CI).read_text()
    return [f"CI does not set {flag}" for flag in sorted(read) if not re.search(rf'^\s*{flag}: "1"\s*$', ci, re.M)]


def gate_drift(tree):
    return ci_drift(tree) + plugin_drift(tree) + require_drift(tree)


def tree_files():
    out = subprocess.run(
        ["git", "ls-files", "-co", "--exclude-standard", "-z"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    ).stdout
    return [p for p in out.decode().split("\0") if p and (ROOT / p).is_file()]


def copy_tree(files, dest):
    for f in files:
        target = dest / f
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / f, target)


def run_lint(tree, lint):
    return subprocess.run([sys.executable, str(tree / "scripts" / lint)], cwd=tree, capture_output=True, text=True)


def main():
    files = tree_files()
    failures = []
    with tempfile.TemporaryDirectory(prefix="arrix-gate-selftest-") as tmp:
        clean = Path(tmp) / "clean"
        copy_tree(files, clean)
        for lint in LINTS:
            r = run_lint(clean, lint)
            if r.returncode != 0:
                print(f"gate-selftest: {lint} fails on the clean tree:\n{r.stderr}", file=sys.stderr)
                return 1
        drift = gate_drift(clean)
        if drift:
            print(f"gate-selftest: {CI}, the gate and the plugins disagree:", file=sys.stderr)
            for d in drift:
                print(f"- {d}", file=sys.stderr)
            return 1
        print(f"  ok  {CI} runs exactly the gate's {len(gate_commands(clean))} commands")
        print(f"  ok  the gate runs each of the {len(list(clean.glob('plugins/*/Cargo.toml')))} plugin workspaces")
        print("  ok  CI sets every ARRIX_REQUIRE_* flag the tests read")
        for i, (name, file, old, new) in enumerate(DRIFT_CASES):
            tree = Path(tmp) / f"drift{i}"
            shutil.copytree(clean, tree)
            if old is None:
                (tree / file).parent.mkdir(parents=True, exist_ok=True)
                (tree / file).write_text(new)
            else:
                text = (tree / file).read_text()
                assert old in text, f"drift case {name!r}: {old!r} not in {file}"
                (tree / file).write_text(text.replace(old, new, 1))
            ok = bool(gate_drift(tree))
            print(f"  {'ok ' if ok else 'BAD'} the CI check fails on: {name}")
            if not ok:
                failures.append(f"{name}: the CI check saw no drift")
            shutil.rmtree(tree)
        for i, (name, lint, file, snippet, expected) in enumerate(CASES):
            tree = Path(tmp) / f"case{i}"
            shutil.copytree(clean, tree)
            with open(tree / file, "a") as f:
                f.write(snippet)
            r = run_lint(tree, lint)
            ok = r.returncode == expected
            verdict = "fails" if expected else "passes"
            print(f"  {'ok ' if ok else 'BAD'} {lint} {verdict} on: {name}")
            if not ok:
                failures.append(f"{name}: {lint} exited {r.returncode}, expected {expected}\n{r.stdout}{r.stderr}")
            shutil.rmtree(tree)
    if failures:
        print("\ngate-selftest: FAILED", file=sys.stderr)
        for f in failures:
            print(f"- {f}", file=sys.stderr)
        return 1
    print(f"gate-selftest: {len(CASES) + len(DRIFT_CASES)} cases ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
