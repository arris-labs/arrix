#!/bin/sh
# The slow half of the gate (docs/ARCHITECTURE.md §Gates, ADR-0041), mirrored
# by CI. `/work` runs it before a step's box is ticked (.agents/rules/git.md);
# no hook runs it, and pre-commit runs the fast half.
set -e
# Runs in a scope of its own, so memory pressure never takes the terminal
# with it (scripts/heavy, .agents/rules/resources.md §Memory).
[ -n "$ARRIX_HEAVY" ] || exec "$(git rev-parse --show-toplevel)/scripts/heavy" "$0" "$@"
cd "$(git rev-parse --show-toplevel)"
# One gate at a time per target directory: the tests' scratch directories
# under CARGO_TARGET_TMPDIR have fixed names, and two gates at once also
# double the memory (.agents/rules/resources.md). A second gate waits.
mkdir -p "${CARGO_TARGET_DIR:-target}"
exec 9>"${CARGO_TARGET_DIR:-target}/.gate.lock"
command -v flock >/dev/null && { flock -n 9 || { echo "gate: another gate holds ${CARGO_TARGET_DIR:-target}; waiting" >&2; flock 9; }; }

# nextest runs the tests of many binaries at once under one thread budget
# (.config/nextest.toml, ADR-0040); it runs no doctests, so those go beside.
command -v cargo-nextest >/dev/null || { echo "gate: cargo-nextest is missing: cargo install cargo-nextest --locked" >&2; exit 1; }
# The wasm32 tests run under Node and the browser tests build their pages
# with wasm-bindgen (plans/c4 steps 2 and 3); both must be the lock's
# wasm-bindgen (Cargo.toml). The browser tests skip loudly without Chromium.
command -v wasm-bindgen-test-runner >/dev/null || { echo "gate: wasm-bindgen-cli is missing: cargo install wasm-bindgen-cli --version '=0.2.129' --locked" >&2; exit 1; }

echo "gate: cargo nextest run"
cargo nextest run --workspace

echo "gate: cargo nextest run --all-features"
cargo nextest run --workspace --all-features

echo "gate: doctests"
cargo test --workspace --doc

echo "gate: wasm32 build"
cargo build --target wasm32-unknown-unknown --workspace --exclude arrix-cli --exclude arrix-plugin-test --exclude arrix-web-test

# wasm32 evaluates as native does (plans/c4 step 2), under Node.
command -v node >/dev/null || { echo "gate: node is missing: the wasm32 tests run under Node" >&2; exit 1; }
echo "gate: wasm32 tests"
cargo test --target wasm32-unknown-unknown -p arrix-plugin-host --test wasm_determinism

# Each Rust plugin is a workspace of its own (plans/c3-m3 Findings 7): its
# tests, and its Tier 1 module where its own guest test builds it.
echo "gate: plugins/gears"
cargo nextest run --manifest-path plugins/gears/Cargo.toml
cargo test --doc --manifest-path plugins/gears/Cargo.toml
cargo build --release --target wasm32-unknown-unknown --features guest --manifest-path plugins/gears/Cargo.toml --target-dir plugins/gears/target/guest
echo "gate: plugins/robotics"
cargo nextest run --manifest-path plugins/robotics/Cargo.toml
cargo test --doc --manifest-path plugins/robotics/Cargo.toml
cargo build --release --target wasm32-unknown-unknown --features guest --manifest-path plugins/robotics/Cargo.toml --target-dir plugins/robotics/target/guest

echo "gate: gate-selftest"
scripts/gate-selftest
